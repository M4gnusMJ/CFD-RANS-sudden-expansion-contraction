FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// epsilon = Cmu^0.75 k^1.5 / l with l = 0.07 d1, computed by case_design.py.
#include "include/initialConditions"

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform $epsilonInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $epsilonInlet;
    }

    outlet
    {
        type            zeroGradient;
    }

    // LaunderSharmaKE solves for epsilonTilda, which is zero at the wall by
    // construction. epsilonWallFunction imposes the log-layer value instead,
    // which is meaningless at y+ = 1 and fights the low-Re model - that gave
    // 3386 "bounding epsilon" messages and stalled the residuals. A tiny
    // positive value keeps nut = Cmu fMu k^2 / epsilon finite.
    upperWall
    {
        type            fixedValue;
        value           uniform 1e-10;
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

