FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// k = 1.5 (U1 I)^2 with I = 0.16 Re1^(-1/8), computed by case_design.py.
#include "include/initialConditions"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $kInlet;
    }

    outlet
    {
        type            zeroGradient;
    }

    // Low-Re: the boundary layer is resolved (y+ ~ 1), so the high-Re
    // kqRWallFunction is not valid. kLowReWallFunction blends to k = 0.
    upperWall
    {
        type            kLowReWallFunction;
        value           uniform 1e-10;
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

