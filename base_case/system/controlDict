FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;

// Iteration cap only. residualControl in fvSolution stops the run earlier once
// it is converged, so this just has to be comfortably larger than needed.
endTime         100000;
deltaT          1;

writeControl    timeStep;
writeInterval   2000;
purgeWrite      3;

writeFormat     ascii;
writePrecision  12;  // preserve wedge geometry when renumberMesh rewrites points
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    #include "foam_functions"
}

