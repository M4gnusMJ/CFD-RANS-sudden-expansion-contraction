FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Retain PCG/DIC: GAMG previously failed on the strongly stretched mesh.
    // The revised grading reduces aspect ratios without changing the solver.
    p
    {
        solver          PCG;
        preconditioner  DIC;
        //solver              GAMG;
        //smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.0001; // Set rel tol to 0 due to oscillations preventing convergence
    }

    "(U|k|epsilon|omega|f|v2)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;

    // Strict whole-vector fallback. system/convergence_controls additionally
    // permits a larger normalized Uz residual while keeping Ux/Uy strict.
    // The wedge-centre Uz velocity is near zero; its normalized residual can
    // remain large. Do not loosen the whole U threshold to accommodate it.
    residualControl
    {
        p               2e-2; // Increased to 3 e-3, as it would not converge otherwise
        U               2e-4;
        "(k|epsilon|omega|f|v2)" 5e-5;
    }
}

relaxationFactors
{   
    fields 
    {
        p               0.8;
    }
    // Lowered from 0.9. Slower per iteration but far less likely to tip into
    // the limit cycle the first attempt got stuck in.
    equations
    {
        U               0.6;
        ".*"            0.6;
    }
}

